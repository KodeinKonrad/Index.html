<!DOCTYPE html>

<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
  <title>Claude Dashboard</title>

  <!-- iOS Home Screen Support -->

  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Claude" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="theme-color" content="#0a0a0f" />

  <!-- Icon als Inline-SVG (kein Upload nötig) -->

  <link rel="apple-touch-icon" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%23d4a056'/><stop offset='1' stop-color='%23b8860b'/></linearGradient></defs><rect width='180' height='180' rx='40' fill='url(%23g)'/><path d='M90 55 L125 90 L90 125 L55 90 Z' fill='%230a0a0f'/></svg>" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><defs><linearGradient id='g' x1='0' y1='0' x2='1' y2='1'><stop offset='0' stop-color='%23d4a056'/><stop offset='1' stop-color='%23b8860b'/></linearGradient></defs><rect width='180' height='180' rx='40' fill='url(%23g)'/><path d='M90 55 L125 90 L90 125 L55 90 Z' fill='%230a0a0f'/></svg>" />

  <!-- Fonts -->

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet" />

  <style>
    * { -webkit-tap-highlight-color: transparent; box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0;
      background: #0a0a0f;
      color: #f0e6d3;
      font-family: 'DM Sans', -apple-system, sans-serif;
      min-height: 100dvh;
      overscroll-behavior: none;
    }
    #root { min-height: 100dvh; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
    @keyframes fadeUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
    input, textarea, button { font-family: inherit; }
  </style>

  <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>

  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>

  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

</head>
<body>
  <div id="root"></div>

  <script type="text/babel" data-presets="react">
    const { useState, useRef, useEffect, useCallback } = React;

    const SYSTEM_PROMPTS = {
      daily: "Du bist ein persönlicher Assistent in einem iOS-Dashboard. Gib eine kurze, motivierende Tageszusammenfassung in 2-3 Sätzen auf Deutsch. Sei warm und konkret. Kein Smalltalk.",
      quick: "Du bist ein hilfreicher Assistent. Antworte auf Deutsch, präzise und kompakt. Maximal 3-4 Sätze, es sei denn die Frage erfordert mehr.",
      chat: "Du bist Claude, ein hilfreicher KI-Assistent von Anthropic. Antworte auf Deutsch. Sei gründlich aber nicht ausschweifend.",
      ideas: "Du bist ein kreativer Ideengeber. Generiere 3 kurze, ungewöhnliche Projektideen zu einem Thema. Auf Deutsch, als nummerierte Liste. Jede Idee maximal 2 Sätze.",
      summarize: "Du bist ein Zusammenfassungs-Experte. Fasse den gegebenen Text in 3-5 Kernpunkten auf Deutsch zusammen. Nummerierte Liste.",
    };

    const KEY_STORAGE = "claude_dashboard_api_key";

    async function callClaude(apiKey, messages, systemPrompt) {
      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-api-key": apiKey,
          "anthropic-version": "2023-06-01",
          "anthropic-dangerous-direct-browser-access": "true",
        },
        body: JSON.stringify({
          model: "claude-sonnet-4-5",
          max_tokens: 1024,
          system: systemPrompt,
          messages,
        }),
      });

      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err?.error?.message || `API-Fehler ${response.status}`);
      }

      const data = await response.json();
      return data.content
        .filter((b) => b.type === "text")
        .map((b) => b.text)
        .join("\n");
    }

    function SetupScreen({ onSave }) {
      const [key, setKey] = useState("");
      const [show, setShow] = useState(false);
      const [testing, setTesting] = useState(false);
      const [error, setError] = useState("");

      const testAndSave = async () => {
        setTesting(true);
        setError("");
        try {
          await callClaude(key, [{ role: "user", content: "Hi" }], "Antworte nur mit 'OK'.");
          localStorage.setItem(KEY_STORAGE, key);
          onSave(key);
        } catch (e) {
          setError(e.message || "Verbindung fehlgeschlagen");
        }
        setTesting(false);
      };

      return (
        <div style={{
          minHeight: "100dvh", display: "flex", flexDirection: "column",
          justifyContent: "center", alignItems: "center", padding: 24,
          background: "linear-gradient(170deg, #0a0a0f 0%, #141420 50%, #1a1410 100%)",
        }}>
          <div style={{ width: "100%", maxWidth: 380 }}>
            <div style={{ textAlign: "center", marginBottom: 40 }}>
              <div style={{
                width: 72, height: 72, borderRadius: 22, margin: "0 auto 20px",
                background: "linear-gradient(135deg, #d4a056 0%, #b8860b 100%)",
                display: "flex", alignItems: "center", justifyContent: "center",
                boxShadow: "0 8px 32px rgba(212,160,86,0.3)",
              }}>
                <svg width="32" height="32" viewBox="0 0 180 180">
                  <path d="M90 40 L140 90 L90 140 L40 90 Z" fill="#0a0a0f"/>
                </svg>
              </div>
              <h1 style={{
                fontFamily: "'DM Serif Display', Georgia, serif", fontSize: 30,
                color: "#f0e6d3", margin: 0, letterSpacing: "-0.02em",
              }}>Claude Dashboard</h1>
              <p style={{ color: "#8a8494", fontSize: 14, marginTop: 8 }}>
                Dein persönliches KI-Cockpit
              </p>
            </div>

            <div style={{
              background: "rgba(255,255,255,0.04)", borderRadius: 16, padding: 24,
              border: "1px solid rgba(255,255,255,0.06)",
            }}>
              <label style={{
                color: "#a09aae", fontSize: 12,
                textTransform: "uppercase", letterSpacing: "0.08em",
              }}>API-Schlüssel</label>
              <div style={{ position: "relative", marginTop: 8 }}>
                <input
                  type={show ? "text" : "password"}
                  value={key}
                  onChange={(e) => setKey(e.target.value)}
                  placeholder="sk-ant-api03-..."
                  autoCapitalize="none"
                  autoCorrect="off"
                  spellCheck="false"
                  style={{
                    width: "100%", padding: "14px 48px 14px 14px", borderRadius: 10,
                    border: "1px solid rgba(255,255,255,0.1)", background: "rgba(0,0,0,0.3)",
                    color: "#f0e6d3", fontSize: 15, fontFamily: "monospace",
                    outline: "none",
                  }}
                />
                <button onClick={() => setShow(!show)} style={{
                  position: "absolute", right: 12, top: "50%", transform: "translateY(-50%)",
                  background: "none", border: "none", color: "#8a8494",
                  cursor: "pointer", fontSize: 18, padding: 4,
                }}>{show ? "◡" : "◉"}</button>
              </div>

              <p style={{ color: "#6a6474", fontSize: 12, marginTop: 10, lineHeight: 1.5 }}>
                Hol dir den Key auf <strong style={{ color: "#d4a056" }}>platform.claude.com</strong> → API Keys → Create Key
              </p>

              {error && (
                <p style={{
                  color: "#e85d5d", fontSize: 13, marginTop: 10,
                  padding: "8px 12px", background: "rgba(232,93,93,0.08)", borderRadius: 8,
                }}>{error}</p>
              )}

              <button onClick={testAndSave} disabled={!key.trim() || testing} style={{
                width: "100%", padding: 14, marginTop: 16, borderRadius: 10,
                border: "none", fontWeight: 600, fontSize: 15, cursor: "pointer",
                background: key.trim() ? "linear-gradient(135deg, #d4a056, #b8860b)" : "rgba(255,255,255,0.06)",
                color: key.trim() ? "#0a0a0f" : "#6a6474",
                opacity: testing ? 0.7 : 1,
              }}>
                {testing ? "Verbindung wird geprüft..." : "Verbinden & Starten"}
              </button>
            </div>

            <p style={{ color: "#3a3444", fontSize: 11, textAlign: "center", marginTop: 20 }}>
              Dein Key wird nur lokal auf diesem Gerät gespeichert.
            </p>
          </div>
        </div>
      );
    }

    function DashCard({ icon, title, accent, children, onClick }) {
      return (
        <div
          onClick={onClick}
          style={{
            background: "rgba(255,255,255,0.03)", borderRadius: 16, padding: 18,
            border: "1px solid rgba(255,255,255,0.05)",
            cursor: onClick ? "pointer" : "default",
            transition: "transform 0.15s",
          }}
          onPointerDown={(e) => onClick && (e.currentTarget.style.transform = "scale(0.98)")}
          onPointerUp={(e) => onClick && (e.currentTarget.style.transform = "scale(1)")}
          onPointerLeave={(e) => onClick && (e.currentTarget.style.transform = "scale(1)")}
        >
          <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: children ? 12 : 0 }}>
            <span style={{
              width: 34, height: 34, borderRadius: 10, display: "flex",
              alignItems: "center", justifyContent: "center", fontSize: 16,
              background: `${accent}18`, color: accent,
            }}>{icon}</span>
            <span style={{ color: "#e8e0d4", fontWeight: 600, fontSize: 15 }}>{title}</span>
            {onClick && <span style={{ marginLeft: "auto", color: "#4a4454", fontSize: 18 }}>›</span>}
          </div>
          {children}
        </div>
      );
    }

    function ToolPage({ title, onBack, children }) {
      return (
        <div style={{
          minHeight: "100dvh",
          background: "linear-gradient(170deg, #0a0a0f 0%, #141420 50%, #1a1410 100%)",
          display: "flex", flexDirection: "column",
        }}>
          <div style={{
            padding: "16px 20px", display: "flex", alignItems: "center", gap: 12,
            borderBottom: "1px solid rgba(255,255,255,0.05)", flexShrink: 0,
            paddingTop: "max(16px, env(safe-area-inset-top))",
          }}>
            <button onClick={onBack} style={{
              background: "rgba(255,255,255,0.06)", border: "none", color: "#d4a056",
              width: 36, height: 36, borderRadius: 10, cursor: "pointer", fontSize: 18,
              display: "flex", alignItems: "center", justifyContent: "center",
            }}>‹</button>
            <h2 style={{
              fontFamily: "'DM Serif Display', Georgia, serif", color: "#f0e6d3",
              fontSize: 20, margin: 0,
            }}>{title}</h2>
          </div>
          <div style={{ flex: 1, display: "flex", flexDirection: "column", overflow: "hidden" }}>
            {children}
          </div>
        </div>
      );
    }

    function ChatPage({ apiKey, onBack }) {
      const [messages, setMessages] = useState([]);
      const [input, setInput] = useState("");
      const [loading, setLoading] = useState(false);
      const scrollRef = useRef(null);

      useEffect(() => {
        scrollRef.current?.scrollTo({ top: scrollRef.current.scrollHeight, behavior: "smooth" });
      }, [messages, loading]);

      const send = async () => {
        if (!input.trim() || loading) return;
        const text = input.trim();
        setInput("");
        const newMsgs = [...messages, { role: "user", content: text }];
        setMessages(newMsgs);
        setLoading(true);
        try {
          const result = await callClaude(apiKey, newMsgs, SYSTEM_PROMPTS.chat);
          setMessages([...newMsgs, { role: "assistant", content: result }]);
        } catch (e) {
          setMessages([...newMsgs, { role: "assistant", content: `⚠️ ${e.message}` }]);
        }
        setLoading(false);
      };

      return (
        <ToolPage title="Chat" onBack={onBack}>
          <div ref={scrollRef} style={{ flex: 1, overflowY: "auto", padding: "16px 16px 8px" }}>
            {messages.length === 0 && (
              <p style={{ color: "#4a4454", textAlign: "center", marginTop: 40, fontSize: 14 }}>
                Starte ein Gespräch mit Claude...
              </p>
            )}
            {messages.map((m, i) => (
              <div key={i} style={{
                display: "flex", justifyContent: m.role === "user" ? "flex-end" : "flex-start",
                marginBottom: 10,
              }}>
                <div style={{
                  maxWidth: "82%", padding: "12px 16px", borderRadius: 16,
                  fontSize: 15, lineHeight: 1.55, whiteSpace: "pre-wrap", wordBreak: "break-word",
                  ...(m.role === "user"
                    ? { background: "linear-gradient(135deg, #d4a056, #b8860b)", color: "#0a0a0f", borderBottomRightRadius: 4 }
                    : { background: "rgba(255,255,255,0.05)", color: "#e0d8cc", borderBottomLeftRadius: 4 }),
                }}>{m.content}</div>
              </div>
            ))}
            {loading && (
              <div style={{ display: "flex", justifyContent: "flex-start", marginBottom: 10 }}>
                <div style={{
                  padding: "12px 16px", borderRadius: 16, borderBottomLeftRadius: 4,
                  background: "rgba(255,255,255,0.05)", color: "#d4a056",
                }}>
                  <span style={{ animation: "blink 1.2s infinite" }}>●</span>
                  <span style={{ animation: "blink 1.2s infinite 0.2s", marginLeft: 4 }}>●</span>
                  <span style={{ animation: "blink 1.2s infinite 0.4s", marginLeft: 4 }}>●</span>
                </div>
              </div>
            )}
          </div>
          <div style={{
            padding: "12px 16px", borderTop: "1px solid rgba(255,255,255,0.05)",
            display: "flex", gap: 10, alignItems: "flex-end", flexShrink: 0,
            paddingBottom: "max(12px, env(safe-area-inset-bottom))",
          }}>
            <textarea
              value={input}
              onChange={(e) => {
                setInput(e.target.value);
                e.target.style.height = "auto";
                e.target.style.height = Math.min(e.target.scrollHeight, 120) + "px";
              }}
              onKeyDown={(e) => {
                if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(); }
              }}
              placeholder="Nachricht..."
              rows={1}
              style={{
                flex: 1, padding: "12px 14px", borderRadius: 12, resize: "none",
                border: "1px solid rgba(255,255,255,0.08)", background: "rgba(0,0,0,0.3)",
                color: "#f0e6d3", fontSize: 15, outline: "none",
                minHeight: 44, maxHeight: 120,
              }}
            />
            <button onClick={send} disabled={!input.trim() || loading} style={{
              width: 44, height: 44, borderRadius: 12, border: "none", cursor: "pointer",
              background: input.trim() ? "linear-gradient(135deg, #d4a056, #b8860b)" : "rgba(255,255,255,0.06)",
              color: input.trim() ? "#0a0a0f" : "#4a4454",
              fontSize: 20, flexShrink: 0,
            }}>↑</button>
          </div>
        </ToolPage>
      );
    }

    function QuickTool({ apiKey, onBack, toolType }) {
      const config = {
        ideas: { title: "Ideen-Generator", prompt: SYSTEM_PROMPTS.ideas, placeholder: "Zu welchem Thema? z.B. 'App-Ideen für Studenten'" },
        summarize: { title: "Zusammenfassen", prompt: SYSTEM_PROMPTS.summarize, placeholder: "Füge hier den Text ein, den du zusammenfassen möchtest..." },
        quick: { title: "Schnelle Frage", prompt: SYSTEM_PROMPTS.quick, placeholder: "Was möchtest du wissen?" },
      }[toolType];

      const [input, setInput] = useState("");
      const [result, setResult] = useState("");
      const [loading, setLoading] = useState(false);

      const run = async () => {
        if (!input.trim()) return;
        setLoading(true);
        setResult("");
        try {
          const text = await callClaude(apiKey, [{ role: "user", content: input }], config.prompt);
          setResult(text);
        } catch (e) {
          setResult(`⚠️ ${e.message}`);
        }
        setLoading(false);
      };

      return (
        <ToolPage title={config.title} onBack={onBack}>
          <div style={{ flex: 1, overflowY: "auto", padding: 16 }}>
            <textarea
              value={input}
              onChange={(e) => setInput(e.target.value)}
              placeholder={config.placeholder}
              rows={4}
              style={{
                width: "100%", padding: 14, borderRadius: 12, resize: "vertical",
                border: "1px solid rgba(255,255,255,0.08)", background: "rgba(0,0,0,0.3)",
                color: "#f0e6d3", fontSize: 15, outline: "none",
                minHeight: 100,
              }}
            />
            <button onClick={run} disabled={!input.trim() || loading} style={{
              width: "100%", padding: 14, marginTop: 12, borderRadius: 12,
              border: "none", fontWeight: 600, fontSize: 15, cursor: "pointer",
              background: input.trim() ? "linear-gradient(135deg, #d4a056, #b8860b)" : "rgba(255,255,255,0.06)",
              color: input.trim() ? "#0a0a0f" : "#6a6474",
            }}>
              {loading ? "Claude denkt..." : "Ausführen"}
            </button>

            {result && (
              <div style={{
                marginTop: 20, padding: 16, borderRadius: 14,
                background: "rgba(255,255,255,0.04)", border: "1px solid rgba(255,255,255,0.06)",
                color: "#e0d8cc", fontSize: 15, lineHeight: 1.6, whiteSpace: "pre-wrap",
              }}>{result}</div>
            )}
          </div>
        </ToolPage>
      );
    }

    function App() {
      const [apiKey, setApiKey] = useState(() => localStorage.getItem(KEY_STORAGE) || "");
      const [page, setPage] = useState("home");
      const [dailyMsg, setDailyMsg] = useState("");
      const [dailyLoading, setDailyLoading] = useState(false);

      const greet = () => {
        const h = new Date().getHours();
        if (h < 12) return "Guten Morgen";
        if (h < 17) return "Guten Tag";
        if (h < 22) return "Guten Abend";
        return "Gute Nacht";
      };

      const loadDaily = useCallback(async () => {
        if (!apiKey) return;
        setDailyLoading(true);
        try {
          const text = await callClaude(
            apiKey,
            [{
              role: "user",
              content: `Es ist ${new Date().toLocaleDateString("de-DE", { weekday: "long", day: "numeric", month: "long" })}. Gib mir meine Tageszusammenfassung.`,
            }],
            SYSTEM_PROMPTS.daily
          );
          setDailyMsg(text);
        } catch (e) {
          setDailyMsg(`⚠️ ${e.message}`);
        }
        setDailyLoading(false);
      }, [apiKey]);

      useEffect(() => {
        if (apiKey && !dailyMsg) loadDaily();
      }, [apiKey]);

      const logout = () => {
        if (confirm("API-Key löschen und abmelden?")) {
          localStorage.removeItem(KEY_STORAGE);
          setApiKey("");
          setDailyMsg("");
        }
      };

      if (!apiKey) return <SetupScreen onSave={setApiKey} />;

      if (page === "chat") return <ChatPage apiKey={apiKey} onBack={() => setPage("home")} />;
      if (page === "quick") return <QuickTool apiKey={apiKey} onBack={() => setPage("home")} toolType="quick" />;
      if (page === "ideas") return <QuickTool apiKey={apiKey} onBack={() => setPage("home")} toolType="ideas" />;
      if (page === "summarize") return <QuickTool apiKey={apiKey} onBack={() => setPage("home")} toolType="summarize" />;

      return (
        <div style={{
          minHeight: "100dvh",
          background: "linear-gradient(170deg, #0a0a0f 0%, #141420 50%, #1a1410 100%)",
          paddingTop: "env(safe-area-inset-top)",
          paddingBottom: "env(safe-area-inset-bottom)",
        }}>
          <div style={{ padding: "24px 20px 12px" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <div>
                <h1 style={{
                  fontFamily: "'DM Serif Display', Georgia, serif", color: "#f0e6d3",
                  fontSize: 26, margin: 0, letterSpacing: "-0.02em",
                }}>{greet()}</h1>
                <p style={{ color: "#6a6474", fontSize: 13, margin: "4px 0 0" }}>
                  {new Date().toLocaleDateString("de-DE", { weekday: "long", day: "numeric", month: "long" })}
                </p>
              </div>
              <button onClick={logout} style={{
                width: 38, height: 38, borderRadius: 12,
                border: "1px solid rgba(255,255,255,0.06)",
                background: "rgba(255,255,255,0.03)", color: "#8a8494",
                cursor: "pointer", fontSize: 16,
              }}>⚙</button>
            </div>
          </div>

          <div style={{ padding: "4px 16px 24px", display: "flex", flexDirection: "column", gap: 12 }}>
            <div style={{ animation: "fadeUp 0.4s ease" }}>
              <DashCard icon="☀" title="Tagesimpuls" accent="#d4a056">
                {dailyMsg ? (
                  <p style={{ color: "#c8c0b4", fontSize: 14, lineHeight: 1.6, margin: 0 }}>{dailyMsg}</p>
                ) : (
                  <p style={{ color: "#4a4454", fontSize: 14, margin: 0 }}>
                    {dailyLoading ? "Claude bereitet deinen Tag vor..." : "Wird geladen..."}
                  </p>
                )}
                <button onClick={loadDaily} disabled={dailyLoading} style={{
                  marginTop: 10, padding: "6px 14px", borderRadius: 8, border: "none",
                  background: "rgba(212,160,86,0.12)", color: "#d4a056", fontSize: 12,
                  fontWeight: 600, cursor: "pointer",
                }}>↻ Neuer Impuls</button>
              </DashCard>
            </div>

            <div style={{ animation: "fadeUp 0.4s ease 0.05s", animationFillMode: "backwards" }}>
              <DashCard icon="💬" title="Chat mit Claude" accent="#6baa75" onClick={() => setPage("chat")}>
                <p style={{ color: "#6a6474", fontSize: 13, margin: 0 }}>Ausführliches Gespräch starten</p>
              </DashCard>
            </div>

            <div style={{ animation: "fadeUp 0.4s ease 0.1s", animationFillMode: "backwards" }}>
              <DashCard icon="⚡" title="Schnelle Frage" accent="#5b9bd5" onClick={() => setPage("quick")}>
                <p style={{ color: "#6a6474", fontSize: 13, margin: 0 }}>Kompakte Antwort in Sekunden</p>
              </DashCard>
            </div>

            <div style={{ animation: "fadeUp 0.4s ease 0.15s", animationFillMode: "backwards" }}>
              <DashCard icon="💡" title="Ideen-Generator" accent="#c4a35a" onClick={() => setPage("ideas")}>
                <p style={{ color: "#6a6474", fontSize: 13, margin: 0 }}>3 kreative Ideen zu jedem Thema</p>
              </DashCard>
            </div>

            <div style={{ animation: "fadeUp 0.4s ease 0.2s", animationFillMode: "backwards" }}>
              <DashCard icon="📋" title="Text zusammenfassen" accent="#b07aac" onClick={() => setPage("summarize")}>
                <p style={{ color: "#6a6474", fontSize: 13, margin: 0 }}>Kernpunkte auf einen Blick</p>
              </DashCard>
            </div>

            <p style={{ color: "#3a3444", fontSize: 11, textAlign: "center", marginTop: 8 }}>
